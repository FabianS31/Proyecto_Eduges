# Copiar este archivo como .env (en esta misma carpeta, junto a manage.py)
# y completar los valores. El .env NUNCA se sube a Git.

# Generar una clave nueva con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# True solo en desarrollo
DJANGO_DEBUG=True

# Hosts separados por coma
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=EduGes
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
